# ==============================================================================
# Agentic Customer Analytics Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL.

# Application Environment (development, testing, production)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# Persistence Settings
# For local development and demonstration: SQLite file or in-memory
# For production: postgresql+psycopg2://user:password@localhost:5432/analytics_db
DATABASE_URL=sqlite:///./data/analytics.db
# Dedicated least-privilege read-only connection URL for Agent SQL queries
AGENT_DATABASE_URL=sqlite:///./data/analytics.db

# Processing Engine
# Set to true if Apache Spark and Java 8/11/17 are installed and configured
SPARK_ENABLED=false
SPARK_MASTER=local[*]
SPARK_APP_NAME=CustomerAnalyticsPlatform

# File & Directory Paths (relative to project root or absolute)
DATA_DIR=./data
RAW_DATA_PATH=./data/raw/transactions.csv
PROCESSED_DATA_PATH=./data/processed/customer_features.parquet
MODEL_ARTIFACT_DIR=./artifacts/models
REPORT_DIR=./artifacts/reports

# Machine Learning & Feature Engineering
REPRODUCIBILITY_SEED=42
MODEL_VERSION=v1.0.0
CHURN_OBSERVATION_DAYS=180
CHURN_HORIZON_DAYS=90
RECALL_MINIMUM_PRECISION=0.35

# SQL Security & Guardrails
SQL_MAX_QUERY_LENGTH=1000
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=100
SQL_ALLOWED_TABLES=rfm_segments,customer_features,daily_metrics,segment_summaries,churn_risk_scores

# Agent & LLM Configuration (OPTIONAL)
# Platform functions fully with deterministic fallback if LLM is not configured
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
AGENT_TIMEOUT_SECONDS=30.0

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
